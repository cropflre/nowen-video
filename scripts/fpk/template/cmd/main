#!/bin/bash

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"

is_docker_running() {
  DOCKER_NAME=""
  if [ -f "$FILE_PATH" ]; then
    DOCKER_NAME=$(grep "container_name" "$FILE_PATH" | awk -F ':' '{print $2}' | xargs)
  fi

  if [ -n "$DOCKER_NAME" ]; then
    docker inspect "$DOCKER_NAME" 2>/dev/null | grep -q '"Status": "running"' || exit 1
    return
  fi
  exit 1
}

case "${1:-}" in
  start|stop)
    # Docker project lifecycle is managed by fnOS App Center.
    exit 0
    ;;
  status)
    if is_docker_running; then exit 0; else exit 3; fi
    ;;
  *)
    exit 1
    ;;
esac
