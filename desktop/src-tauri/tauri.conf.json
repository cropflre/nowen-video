{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "Nowen Video",
  "version": "1.2.5",
  "identifier": "com.nowen.video.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:28889",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nowen Video",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Nowen Video"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/mpv/libmpv-2.dll": "./libmpv-2.dll",
      "resources/yt-dlp.exe": "./yt-dlp.exe",
      "resources/shaders/": "./resources/shaders/",
      "resources/fonts/": "./resources/fonts/"
    },
    "externalBin": [
      "bin/nowen-video"
    ],
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "avi", "mov", "wmv", "flv", "webm", "ts", "m2ts", "rmvb", "m4v"],
        "name": "Nowen Video",
        "description": "Nowen Video 支持的视频文件",
        "role": "Viewer"
      }
    ],
    "category": "Entertainment",
    "shortDescription": "Nowen Video 桌面媒体中心",
    "longDescription": "Nowen Video Desktop 2.0 —— 基于 Tauri 2、Go Media Core 与 libmpv 的本地优先桌面媒体中心。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["mpv"]
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cropflre/nowen-video/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "dialog": false
    },
    "deep-link": {
      "desktop": {
        "schemes": ["nowen-video"]
      }
    }
  }
}
