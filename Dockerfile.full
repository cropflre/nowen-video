# syntax=docker/dockerfile:1.6
# Full compatibility image: legacy server entrypoint plus Python adult scraper.

FROM --platform=$BUILDPLATFORM node:20-alpine AS frontend
ARG NOWEN_VERSION=0.1.0
WORKDIR /app/web
COPY web/package*.json ./
RUN npm ci
COPY web/ .
ENV VITE_APP_VERSION=${NOWEN_VERSION}
RUN npm run build

FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS backend
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
ARG NOWEN_VERSION=0.1.0
WORKDIR /app
ENV GOPROXY=https://goproxy.cn,https://goproxy.io,direct
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN set -eux; \
    GOARM_VAL=""; \
    if [ "${TARGETARCH}" = "arm" ]; then \
      GOARM_VAL="${TARGETVARIANT#v}"; \
      GOARM_VAL="${GOARM_VAL:-7}"; \
    fi; \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOARM=${GOARM_VAL} \
      go build -trimpath \
        -ldflags="-s -w -X github.com/nowen-video/nowen-video/internal/version.Version=${NOWEN_VERSION}" \
        -o nowen-video ./cmd/server

FROM alpine:3.24
ARG TARGETARCH
ARG NOWEN_VERSION=0.1.0
ARG INSTALL_MESA_VA=false

RUN set -eux; \
    PKGS="ffmpeg tzdata ca-certificates su-exec coreutils wget python3 py3-flask py3-requests py3-beautifulsoup4 py3-lxml"; \
    if [ "${TARGETARCH}" = "amd64" ]; then \
      PKGS="${PKGS} intel-media-driver libva-intel-driver"; \
    fi; \
    if [ "${INSTALL_MESA_VA}" = "true" ]; then \
      PKGS="${PKGS} mesa-va-gallium"; \
    fi; \
    apk add --no-cache ${PKGS}; \
    rm -rf /var/cache/apk/* /usr/share/doc/* /usr/share/man/* /usr/share/info/* /tmp/*; \
    ln -sf /bin/nice /usr/bin/nice; \
    addgroup -S nowen && adduser -S nowen -G nowen; \
    mkdir -p /data /cache /media; \
    ffmpeg -version | head -n 1; \
    ffprobe -version | head -n 1

WORKDIR /app
COPY --from=backend /app/nowen-video /usr/local/bin/nowen-video
COPY --from=frontend /app/web/dist /app/web/dist
COPY scripts/adult-scraper /app/scripts/adult-scraper
COPY --chmod=755 scripts/docker-entrypoint.sh /entrypoint.sh

RUN chown -R nowen:nowen /data /cache /media /app/scripts

ENV NOWEN_APP_PORT=8080
ENV NOWEN_APP_DATA_DIR=/data
ENV NOWEN_APP_WEB_DIR=/app/web/dist
ENV NOWEN_DATABASE_DB_PATH=/data/nowen.db
ENV NOWEN_CACHE_CACHE_DIR=/cache
ENV NOWEN_LOGGING_LEVEL=error
ENV NOWEN_VERSION=${NOWEN_VERSION}
ENV NOWEN_ADULT_SCRAPER_ENABLED=false
ENV NOWEN_ADULT_SCRAPER_AUTO_START_PYTHON=true
ENV NOWEN_ADULT_SCRAPER_PYTHON_EXECUTABLE=/usr/bin/python3
ENV NOWEN_ADULT_SCRAPER_PYTHON_SERVICE_DIR=/app/scripts/adult-scraper
ENV TZ=Asia/Shanghai

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://localhost:8080/api/health || exit 1

CMD ["/entrypoint.sh"]
